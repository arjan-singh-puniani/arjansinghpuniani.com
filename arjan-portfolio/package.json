{
  "name": "arjan-singh-puniani-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern 'playwright-report/**' --ignore-pattern 'test-results/**' --ignore-pattern 'public/hemodynamic-observatory/**'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests",
    "test:watch": "vitest",
    "test:coverage": "vitest run tests --coverage",
    "test:e2e": "playwright test",
    "test:e2e:deployed": "playwright test e2e/smoke.spec.ts e2e/metadata.spec.ts e2e/platform.spec.ts --project=desktop-chromium",
    "test:e2e:headed": "playwright test --headed",
    "lighthouse": "lhci autorun",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "next": "15.5.24",
    "react": "19.1.5",
    "react-dom": "19.1.5",
    "zod": "4.1.12",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/eslintrc": "3.3.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitest/coverage-v8": "4.0.8",
    "autoprefixer": "10.4.21",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.24",
    "jsdom": "26.1.0",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.18",
    "typescript": "5.9.3",
    "vitest": "4.0.8"
  }
}
