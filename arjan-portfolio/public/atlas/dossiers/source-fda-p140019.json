      {
        "application": "P140019",
        "supplement": "",
        "date": "2015-11-03",
        "decision": "PMA approval",
        "tradeName": "I-FACTOR PEPTIDE ENHANCED BONE GRAFT",
        "applicant": "Cerapedics, LLC",
        "statement": "APPROVAL FOR THE I-FACTOR PEPTIDE ENHANCED BONE GRAFT. THIS COMBINATION PRODUCT IS INDICATED FOR USE IN SKELETALLY MATURE PATIENTS FOR RECONSTRUCTION OF A DEGENERATED CERVICAL DISC AT ONE LEVEL FROM C3-C4 TO C6-C7 FOLLOWING SINGLE-LEVEL DISCECTOMY FOR INTRACTABLE RADICULOPATHY (ARM PAIN AND/OR A NEUROLOGICAL DEFICIT), WITH OR WITHOUT NECK PAIN, OR MYELOPATHY DUE TO A SINGLE-LEVEL ABNORMALITY LOCALIZED TO THE DISC SPACE, AND CORRESPONDING TO AT LEAST ONE OF THE FOLLOWING CONDITIONS CONFIRMED BY RADIOGRAPHIC IMAGING (CT, MRI, X-RAYS): HERNIATED NUCLEUS PULPOSUS, SPONDYLOSIS (DEFINED BY THE PRESENCE OF OSTEOPHYTES), AND/OR VISIBLE LOSS OF DISC HEIGHT AS COMPARED TO ADJACENT LEVELS, AFTER FAILURE OF AT LEAST 6 WEEKS OF CONSERVATIVE TREATMENT. I-FACTOR PEPTIDE ENHANCED BONE GRAFT P-15 PUTTY MUST BE USED INSIDE AN ALLOGRAFT BONE RING AND WITH SUPPLEMENTAL ANTERIOR PLATE FIXATION.",
        "reason": "",
        "type": "",
