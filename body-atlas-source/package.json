{
  "name": "body-atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:ingestion": "python3 -m unittest discover -s ingestion -p 'test_*.py' -v",
    "test:browser": "playwright test",
    "ingest": "python3 ingestion/pipeline.py refresh",
    "snapshot": "python3 ingestion/pipeline.py export",
    "verify": "npm run typecheck && npm test && npm run test:ingestion && npm run build"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.180.0",
    "@react-three/fiber": "9.8.2",
    "@react-three/drei": "^10.7.6",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@axe-core/playwright": "^4.11.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.3",
    "tsx": "^4.20.0"
  }
}
