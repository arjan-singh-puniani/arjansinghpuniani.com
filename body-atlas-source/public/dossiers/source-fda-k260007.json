    "findings": [
      {
        "text": "The manufacturer’s cleared indications explicitly state that these suppositories are not compatible with condoms. No condom-material exception is established for K260007.",
        "sourceUrl": "https://www.accessdata.fda.gov/cdrh_docs/pdf26/K260007.pdf",
        "locator": "Manufacturer 510(k) summary §4; PDF p.5; comparison table PDF p.7"
      },
      {
        "text": "This clearance covers 5 mg and 10 mg HA formulations containing vitamin E, cocoa butter and semi-synthetic glycerides. The Revaree Plus predicate has different excipients; its package warnings cannot be transferred merely because both contain HA.",
        "sourceUrl": "https://www.accessdata.fda.gov/cdrh_docs/pdf26/K260007.pdf",
        "locator": "Manufacturer 510(k) summary §§5–6; PDF pp.5–7"
      },
      {
        "text": "Hudi offers custom private-label formulas. Its public product page does not identify a complete US package insert and revision for these two cleared configurations.",
        "sourceUrl": "https://www.hudipharma.com/vaginal-suppository/",
        "locator": "Vaginal Suppository — Custom Formulas; Hyaluronic Acid Vaginal Suppository"
      }
    ],
